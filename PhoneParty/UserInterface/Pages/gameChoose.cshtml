@page "/"
@model PhoneParty.Pages.gameChoose

@{
    ViewData["Title"] = "PhoneParty";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="flex-grow-1"></div>

<h1 class="zanzegi-font title-color title">Phone Party</h1>
<div class="flex-grow-1"></div>

<h3 class="goznak-font text-center">Выберите игру</h3>

<button class="rounded-button-1" onclick="location.href = '/whoami'">Кто Я?</button>
<button class="rounded-button-1 off-rounded-button-1" onclick="">В разработке...</button>

<div class="flex-grow-1"></div>
<div class="d-flex justify-content-center align-items-center gap-3">
    <h3 class="goznak-font">Позови<br>друзей!</h3>
    <img src="/img/qr-code.png" class="index-qr-code" alt="qr-code">
</div>
